# Copy to .env and adjust. Every variable is optional.
# Without the LLM_* variables the demo calls no external service and needs no secret.
# .env is ignored by Git and by the Docker build: the key never leaves the server.

# Port the app listens on inside the container (Hugging Face Spaces uses 7860).
PORT=7860

# Dataset built at startup.
DEMO_SEED=42
# Number of claim lines (2000 to 50000). A smaller value starts faster and uses less memory.
DEMO_SIZE=20000
# 0 = easy to detect, 1 = noisy data and subtle fraud.
DEMO_NOISE=0.2

# Showcase mode: path to a snapshot built by `python -m app.snapshot` (the Docker image sets it).
# Empty = live mode (regeneration on, views computed in the background).
DEMO_SNAPSHOT=

# « Une question ? » chat, answered by a language model on the server (optional).
# Empty = no chat button; the « Lecture IA » commentaries are static in every case.
# The key is read by the app at startup and only sent to the provider in a request header;
# it is never returned to the browser nor logged.
# openai = any OpenAI-compatible API (set LLM_BASE_URL for another host); or anthropic.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
# Hard daily budget of model calls (one or two per question); past it the chat says it is closed
# for the day.
LLM_MAX_CALLS_PER_DAY=200
