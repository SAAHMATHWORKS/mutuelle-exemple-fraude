# Nginx site for the demo behind Cloudflare (proxied record, "Full" or "Full (strict)" SSL).
# Replace the three placeholders, save as /etc/nginx/sites-available/<domain>,
# link it into sites-enabled, then: sudo nginx -t && sudo systemctl reload nginx
#
#   __DOMAIN__     the public name, e.g. demo.example.com
#   __CERT__       Cloudflare origin certificate covering that name (.pem)
#   __KEY__        its private key (.key)
# The upstream port matches DEMO_HOST_PORT in docker-compose.yml (default 8020).

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __DOMAIN__;

    ssl_certificate     __CERT__;
    ssl_certificate_key __KEY__;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    # The demo only reads: small bodies are enough.
    client_max_body_size 64k;

    gzip on;
    gzip_types application/json application/javascript text/css image/svg+xml;
    gzip_min_length 1024;

    location / {
        proxy_pass http://127.0.0.1:8020;
        proxy_redirect off;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    location /static/ {
        proxy_pass http://127.0.0.1:8020;
        proxy_set_header Host $host;
        expires 1h;
        add_header Cache-Control "public";
    }
}
